# 复制为 .env.local。未配置的服务走内置降级：天气按季节与时段推断，解读用规则模板，
# 场景解析用关键词启发式。各变量的含义与默认值见 docs/开发与维护.md「环境变量」。

# 和风天气：在 https://console.qweather.com 创建项目与凭据，Host 是控制台分配的专属 API Host（不含 https://）
QWEATHER_HOST=your-qweather-api-host
QWEATHER_KEY=your-qweather-key

# DeepSeek：在 https://platform.deepseek.com 创建 API key；后两项可不填，默认如下
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 上游日调用上限：按函数实例计数，Serverless 冷启动即归零。它是纵深防御，
# 替代不了 DeepSeek / 和风控制台里的账户消费上限。触顶后解读退回规则模板，天气退回「季节 + 时段」。
LLM_DAILY_CAP=3000
# 和风免费额度 5 万次/月由天气与 GeoAPI 共用，一次缓存 miss 要打两次上游；800 留有双实例余量。
WEATHER_DAILY_CAP=800

# 自部署域名：canonical、sitemap 与分享卡片的绝对 URL。不填默认 https://fencun.vercel.app
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
